---
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-rose-100 bg-[linear-gradient(to_bottom,#fff,#fff7ed_45%,#fdf2f8)] py-12">
  <div class="pointer-events-none absolute -left-20 top-0 h-56 w-56 rounded-full bg-rose-200/40 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-20 bottom-0 h-56 w-56 rounded-full bg-teal-200/40 blur-3xl"></div>

  <div class="relative z-10 mx-auto flex max-w-6xl flex-col items-center gap-5 px-6 text-center">
    <img
      src="/logo.jpeg"
      alt="Soul Space logo"
      class="h-14 w-14 rounded-full object-cover ring-4 ring-white shadow-md"
      loading="lazy"
    />

    <p class="text-base font-semibold text-gray-900">© {year} Soul Space</p>
    <p class="max-w-md text-sm leading-relaxed text-gray-600">
      Terapia psicológica integral para tu bienestar emocional.
    </p>

    <div class="flex items-center gap-5">
      <a
        href="https://wa.me/527203857008"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="WhatsApp"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-600 transition duration-200 hover:border-green-200 hover:text-green-600"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.52 3.48A11.79 11.79 0 0 0 12 0 11.82 11.82 0 0 0 .25 12.3L0 24l11.82-3.14A11.84 11.84 0 0 0 24 12a11.73 11.73 0 0 0-3.48-8.52zM12 21.5a9.37 9.37 0 0 1-4.67-1.26l-.33-.19-4.27 1.13 1.14-4.16-.21-.34A9.47 9.47 0 0 1 2.5 12 9.51 9.51 0 1 1 12 21.5zm5.21-6.89c-.29-.15-1.74-.86-2-1s-.47-.15-.67.15-.77 1-.94 1.21-.35.23-.64.08a7.64 7.64 0 0 1-2.25-1.38 8.45 8.45 0 0 1-1.56-1.92c-.16-.27 0-.42.12-.57s.27-.34.4-.52a1.79 1.79 0 0 0 .27-.45.51.51 0 0 0 0-.49c-.08-.15-.67-1.61-.92-2.21s-.49-.5-.67-.51h-.57a1.11 1.11 0 0 0-.8.38 3.36 3.36 0 0 0-1.05 2.51 5.86 5.86 0 0 0 1.25 3.1 13.25 13.25 0 0 0 5.1 4.46 12.3 12.3 0 0 0 1.23.45 3 3 0 0 0 1.39.09 3.15 3.15 0 0 0 2.06-1.48 2.62 2.62 0 0 0 .19-1.48c-.08-.13-.26-.21-.55-.36z" />
        </svg>
      </a>

      <a
        href="https://www.instagram.com/soul_space.098"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-600 transition duration-200 hover:border-fuchsia-200 hover:text-fuchsia-600"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M7 2C4.24 2 2 4.24 2 7v10c0 2.76 2.24 5 5 5h10c2.76 0 5-2.24 5-5V7c0-2.76-2.24-5-5-5H7zm10 2c1.65 0 3 1.35 3 3v10c0 1.65-1.35 3-3 3H7c-1.65 0-3-1.35-3-3V7c0-1.65 1.35-3 3-3h10zm-5 3.5A5.5 5.5 0 1 0 17.5 13 5.5 5.5 0 0 0 12 7.5zm0 9A3.5 3.5 0 1 1 15.5 13 3.5 3.5 0 0 1 12 16.5zm4.75-9.75a1 1 0 1 1 1 1 1 1 0 0 1-1-1z" />
        </svg>
      </a>
    </div>

    <p class="text-xs text-gray-500">Hecho en Pachuca, Hidalgo.</p>
  </div>
</footer>
