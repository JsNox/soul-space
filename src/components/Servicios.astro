---
const servicios = [
  {
    title: "Terapia individual",
    description:
      "Sesiones centradas en tu bienestar emocional, autoconocimiento y manejo de ansiedad o estrés.",
    price: "$210 MXN / sesión",
    icon: "individual",
    tone: "rose",
  },
  {
    title: "Terapia de pareja",
    description:
      "Fortalezcan su comunicación, confianza y vínculo emocional en un espacio seguro y empático.",
    price: "$290 MXN / sesión",
    icon: "pareja",
    tone: "teal",
  },
  {
    title: "Terapia familiar",
    description:
      "Acompañamiento integral para fortalecer la comunicación, empatía y unión familiar en un ambiente de respeto y comprensión.",
    price: "$370 MXN / sesión",
    icon: "familiar",
    tone: "fuchsia",
  },
];
---

<section
  id="servicios"
  class="relative overflow-hidden bg-[radial-gradient(circle_at_10%_20%,rgba(251,113,133,0.14),transparent_35%),radial-gradient(circle_at_85%_12%,rgba(45,212,191,0.18),transparent_35%),linear-gradient(to_bottom,#ffffff,#fff7ed_55%,#f0fdfa)] py-24 md:py-28"
>
  <div class="pointer-events-none absolute -left-20 top-10 h-64 w-64 rounded-full bg-rose-200/50 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-24 bottom-0 h-72 w-72 rounded-full bg-teal-200/40 blur-3xl"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <p class="inline-flex rounded-full border border-teal-200/70 bg-white/70 px-4 py-1.5 text-sm font-semibold text-teal-700">
        Servicios de psicoterapia
      </p>
      <h2 class="mt-5 text-4xl font-black text-gray-900 md:text-5xl">Acompañamiento hecho para ti</h2>
      <p class="mt-4 text-lg leading-relaxed text-gray-700">
        Elige el tipo de terapia que mejor se adapte a tu momento actual. Todas las sesiones
        son con especialistas certificadas y seguimiento cercano.
      </p>
    </div>

    <div class="mt-12 grid gap-7 md:grid-cols-3">
      {servicios.map((servicio, index) => (
        <article
          class="group relative flex h-full flex-col rounded-3xl border border-white/80 bg-white/85 p-8 shadow-md backdrop-blur transition duration-300 hover:-translate-y-1.5 hover:shadow-xl reveal-up"
          style={`animation-delay:${index * 120}ms;`}
        >
          <div
            class:list={[
              "absolute inset-x-0 top-0 h-1 rounded-t-3xl",
              servicio.tone === "rose" && "bg-gradient-to-r from-rose-300 to-rose-500",
              servicio.tone === "teal" && "bg-gradient-to-r from-teal-300 to-teal-500",
              servicio.tone === "fuchsia" && "bg-gradient-to-r from-fuchsia-300 to-fuchsia-500",
            ]}
          ></div>

          <div
            class:list={[
              "mb-5 flex h-14 w-14 items-center justify-center rounded-2xl shadow-inner",
              servicio.tone === "rose" && "bg-rose-50 text-rose-600",
              servicio.tone === "teal" && "bg-teal-50 text-teal-600",
              servicio.tone === "fuchsia" && "bg-fuchsia-50 text-fuchsia-600",
            ]}
          >
            {servicio.icon === "individual" && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 12a4 4 0 100-8 4 4 0 000 8zM6 20a6 6 0 0112 0H6z" />
              </svg>
            )}
            {servicio.icon === "pareja" && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 7a4 4 0 118 0 4 4 0 01-8 0zM3 21v-2a6 6 0 0112 0v2H3zm9 0v-2a6 6 0 0112 0v2h-12z" />
              </svg>
            )}
            {servicio.icon === "familiar" && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 9.75L12 3l9 6.75V21a1 1 0 01-1 1h-5v-5a2 2 0 00-2-2h-2a2 2 0 00-2 2v5H4a1 1 0 01-1-1V9.75z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 13.5l3 3 3-3" />
              </svg>
            )}
          </div>

          <h3 class="text-2xl font-bold text-gray-900">{servicio.title}</h3>
          <p class="mt-3 flex-1 leading-relaxed text-gray-700">{servicio.description}</p>

          <div class="mt-6 flex items-end justify-between gap-4">
            <p class="text-lg font-extrabold text-gray-900">{servicio.price}</p>
            <a
              href="#contacto"
              class:list={[
                "rounded-full px-5 py-2.5 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5",
                servicio.tone === "rose" && "bg-rose-500 hover:bg-rose-600",
                servicio.tone === "teal" && "bg-teal-500 hover:bg-teal-600",
                servicio.tone === "fuchsia" && "bg-fuchsia-500 hover:bg-fuchsia-600",
              ]}
            >
              Agendar
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
