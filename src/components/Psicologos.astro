---
const especialistas = [
  {
    name: "Mtra. Hanna Campos",
    image: "/psicologos/HannaCampos.jpeg",
    focus: "Terapia cognitivo-conductual",
    extra: "6 años de experiencia",
  },
  {
    name: "Lic. Karla Sanabria",
    image: "/psicologos/KarlaSanabria.jpeg",
    focus: "Enfoque humanista",
    extra: "Terapia de pareja y autoestima",
  },
  {
    name: "Psic. Liliana Garrido",
    image: "/psicologos/LilianaGarrido.jpeg",
    focus: "Terapia sistémica",
    extra: "Comunicación familiar",
  },
  {
    name: "Lic. Lizeth Alarcón",
    image: "/psicologos/LizethAlarcon.jpeg",
    focus: "Psicoterapia breve",
    extra: "Manejo de ansiedad",
  },
  {
    name: "Mtra. Miriam Arciga",
    image: "/psicologos/MiriamArciga.jpeg",
    focus: "Terapia integrativa",
    extra: "Inteligencia emocional",
  },
  {
    name: "Psic. Verenice Cisneros",
    image: "/psicologos/VereniceCisneros.jpeg",
    focus: "Enfoque centrado en la persona",
    extra: "Acompañamiento empático",
  },
  {
    name: "Psic. Xochitl Cruz",
    image: "/psicologos/XochCruz.jpeg",
    focus: "Enfoque humanista",
    extra: "Procesos de desarrollo personal",
  },
  {
    name: "Psic. Enrique Ramírez",
    image: "/psicologos/EnriqueRamirez.jpeg",
    focus: "Psicoterapia breve",
    extra: "Manejo de ansiedad",
  },
];
---

<section
  id="psicologos"
  class="relative overflow-hidden bg-[radial-gradient(circle_at_12%_15%,rgba(45,212,191,0.14),transparent_36%),radial-gradient(circle_at_90%_20%,rgba(217,70,239,0.12),transparent_35%),linear-gradient(to_bottom,#ecfeff,#fdf4ff_55%,#ffffff)] py-24 md:py-28"
>
  <div class="pointer-events-none absolute -left-24 top-24 h-72 w-72 rounded-full bg-teal-200/40 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-20 bottom-4 h-72 w-72 rounded-full bg-fuchsia-200/40 blur-3xl"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <p class="inline-flex rounded-full border border-fuchsia-200/70 bg-white/75 px-4 py-1.5 text-sm font-semibold text-fuchsia-700">
        Nuestro equipo
      </p>
      <h2 class="mt-5 text-4xl font-black text-gray-900 md:text-5xl">Profesionales que te acompañan de verdad</h2>
      <p class="mt-4 text-lg leading-relaxed text-gray-700">
        Psicólogas y psicólogos certificados con enfoques terapéuticos diversos para que encuentres a quien mejor se adapte a tu proceso.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {especialistas.map((item, index) => (
        <article
          class="group rounded-3xl border border-white/80 bg-white/85 p-7 shadow-md backdrop-blur transition duration-300 hover:-translate-y-1.5 hover:shadow-xl reveal-up"
          style={`animation-delay:${index * 70}ms;`}
        >
          <div class="mx-auto h-28 w-28 overflow-hidden rounded-2xl ring-4 ring-white shadow-lg">
            <img
              src={item.image}
              alt={item.name}
              class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <h3 class="mt-5 text-center text-2xl font-bold text-gray-900">{item.name}</h3>
          <p class="mt-3 text-center text-sm font-semibold uppercase tracking-wide text-teal-700">{item.focus}</p>
          <p class="mt-1 text-center text-sm text-gray-600">{item.extra}</p>
        </article>
      ))}
    </div>
  </div>
</section>
